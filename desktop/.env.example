# Настройки рабочего места ProЗапас.
#
# Скопировать в .env рядом с программой и поправить под склад. Сам .env в git
# не попадает. Файл можно положить в другое место и указать путь в
# PROZAPAS_ENV_FILE.
#
# Старшинство: переменная окружения → этот файл → значение по умолчанию.
# Пустое значение равносильно отсутствию строки — берётся умолчание.


# ── Сервер ────────────────────────────────────────────────────────────────
# Адрес API вместе с префиксом версии. На складе это имя машины с сервером.
PROZAPAS_API=http://127.0.0.1:8000/api/v1

# Тайм-аут обычного запроса, секунды. Больше — если сеть склада медленная.
PROZAPAS_API_TIMEOUT=10

# Тайм-аут входа. Короче обычного намеренно: человек смотрит на экран и ждёт.
PROZAPAS_API_LOGIN_TIMEOUT=5

# Проверять сертификат сервера. Выключать только если он выписан внутренним CA
# и добавить его в доверенные на машине нельзя.
PROZAPAS_TLS_VERIFY=true

# ── Служба устройств ──────────────────────────────────────────────────────
# Имя именованного канала. Приложение и служба обязаны читать одно и то же:
# при расхождении служба слушает один канал, приложение стучится в другой, и
# все три устройства показывают «Недоступен» без объяснения причины.
PROZAPAS_PIPE_NAME=prozapas-devices

# Через сколько секунд простоя служба закрывается сама. Пока приложение
# подключено, отсчёт не идёт.
PROZAPAS_IDLE_TIMEOUT=30

# Каталог со службой. Пусто — приложение ищет её рядом с собой.
PROZAPAS_DEVICES_SERVICE=

# ── Этикетка коробки ──────────────────────────────────────────────────────
# Размер рулона и плотность печати. На принтере с другой плотностью макет
# уезжает за край — тогда менять здесь, а не в коде.
PROZAPAS_LABEL_WIDTH_MM=58
PROZAPAS_LABEL_HEIGHT_MM=40
PROZAPAS_LABEL_DPI=203

# ── Оборудование ──────────────────────────────────────────────────────────
# Читает служба устройств, не приложение. Пустой порт — служба ищет сама.
# Раскомментировать, когда модели известны.
#PROZAPAS_SCANNER_PORT=COM3
#PROZAPAS_SCANNER_BAUD=115200
#PROZAPAS_SCALE_PORT=COM4
#PROZAPAS_SCALE_BAUD=115200
#PROZAPAS_SCALE_STEP_G=10
#PROZAPAS_PRINTER_NAME=Zebra ZD220
#PROZAPAS_LOG_LEVEL=info

# Куда служба пишет ZPL вместо принтера — для проверки макета без печати.
#PROZAPAS_PRINTER_OUTPUT_FILE=C:\ProgramData\ProZapas\last-label.zpl
