[
  {
    "name": "Main: owner writes and reviews",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [
      {
        "actor_id": 60227285,
        "actor_type": "User",
        "bypass_mode": "always"
      }
    ],
    "conditions": {
      "ref_name": {
        "include": [
          "refs/heads/main"
        ],
        "exclude": []
      }
    },
    "rules": [
      {
        "type": "update",
        "parameters": {
          "update_allows_fetch_and_merge": false
        }
      },
      {
        "type": "pull_request",
        "parameters": {
          "dismiss_stale_reviews_on_push": true,
          "require_code_owner_review": true,
          "require_last_push_approval": true,
          "required_approving_review_count": 1,
          "required_review_thread_resolution": true
        }
      }
    ]
  },
  {
    "name": "Deploy: owner and server release marker",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [
      {
        "actor_id": 60227285,
        "actor_type": "User",
        "bypass_mode": "always"
      },
      {
        "actor_id": null,
        "actor_type": "DeployKey",
        "bypass_mode": "always"
      }
    ],
    "conditions": {
      "ref_name": {
        "include": [
          "refs/heads/deploy"
        ],
        "exclude": []
      }
    },
    "rules": [
      {
        "type": "update",
        "parameters": {
          "update_allows_fetch_and_merge": false
        }
      }
    ]
  },
  {
    "name": "Main and deploy: required CI and preserved history",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [],
    "conditions": {
      "ref_name": {
        "include": [
          "refs/heads/main",
          "refs/heads/deploy"
        ],
        "exclude": []
      }
    },
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      },
      {
        "type": "required_status_checks",
        "parameters": {
          "strict_required_status_checks_policy": true,
          "required_status_checks": [
            {
              "context": "Backend tests",
              "integration_id": 15368
            },
            {
              "context": "Desktop tests",
              "integration_id": 15368
            },
            {
              "context": "System tests",
              "integration_id": 15368
            }
          ]
        }
      }
    ]
  }
]
