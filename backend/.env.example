# Скопировать в .env и заменить значения. Сам .env в git не попадает.
POSTGRES_USER=prozapas_user
POSTGRES_PASSWORD=смените_меня
POSTGRES_DB=prozapas_db

# Учётные записи, которые заводит seed.py
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@prozapas.ru

# Один пароль на все двадцать одну учётную запись сида.
# Это стенд: на рабочем контуре seed.py не запускают.
SEED_PASSWORD=смените_меня

# Подпись access-токенов, не короче 32 знаков.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Смена ключа обесценивает все выданные токены — так выкидывают всех разом.
JWT_SECRET=смените_меня_на_длинную_случайную_строку
